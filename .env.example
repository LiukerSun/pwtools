# 复制为 .env；用足够长的随机字母数字密码替换。
# 该值同时进入 PostgreSQL URL，请使用 URL 安全字符。
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_PORT=5432
API_PORT=8080
API_BIND_IP=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated exact TCP peer IPs of trusted proxies; empty ignores forwarded headers.
# Each trusted proxy must replace X-Real-IP with its verified client address.
TRUSTED_PROXY_IPS=
RUST_LOG=info,tower_http=info

# OSS 仅供 Rust 后端使用；密钥不可写进桌面 .env 或源码。
# 本工具全部对象使用桶内独立 pwtools/ 目录。
OSS_REGION=cn-beijing
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=replace_with_private_bucket
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=pwtools
# 使用临时 STS 凭证时填写；长期凭证留空。
OSS_SECURITY_TOKEN=
## 改枪码属性服务，仅供 API 使用；留空时仍支持私人改枪码管理。
BUILD_CODE_API_TOKEN=
